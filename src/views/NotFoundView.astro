---
import { ui } from '../i18n/ui';
import { path } from '../i18n/utils';
import Base from '../components/layout/Base.astro';
import Ornament from '../components/ornaments/Ornament.astro';

// GitHub Pages sirve un único 404.html para todo el sitio, así que la página habla los dos idiomas.
---
<Base lang="es" routeId="home" title={ui.es['notFound.title']} noindex>
  <section class="nf container">
    <Ornament id="moon-crescent" size={48} />
    <div>
      <h1>{ui.es['notFound.title']}</h1>
      <p>{ui.es['notFound.body']}</p>
      <p><a href={path('home', 'es')}>{ui.es['notFound.home']}</a></p>
    </div>
    <Ornament id="divider-star" width={160} height={16} />
    <div lang="en">
      <h2>{ui.en['notFound.title']}</h2>
      <p>{ui.en['notFound.body']}</p>
      <p><a href={path('home', 'en')} hreflang="en">{ui.en['notFound.home']}</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-5); padding-block: var(--space-section);
  }
  .nf :global(.ornament) { color: var(--realm-accent); }
  h1, h2 { margin: 0 0 var(--space-3); font-size: var(--font-size-3xl); }
  p { margin: 0 auto var(--space-3); }
</style>
