---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/pinyon-script/400.css';
import '@fontsource/noto-sans-symbols/400.css';
import '@fontsource/noto-sans-runic/400.css';
import '../../styles/global.css';
import '../../styles/print.css';

import type { Lang } from '../../i18n/ui';
import type { RouteId } from '../../i18n/routes';
import { t } from '../../i18n/utils';
import { realmBg, type Realm } from '../../lib/tokens';
import Seo from './Seo.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  routeId: RouteId;
  realm?: Realm;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, routeId, realm = 'noche', title, description, noindex } = Astro.props;
const tr = t(lang);
const siteName = tr('site.name');
const fullTitle = title && title !== siteName ? `${title} · ${siteName}` : siteName;
---
<!doctype html>
<html lang={lang} data-realm={realm}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content={realmBg(realm)} />
    <Seo lang={lang} routeId={routeId} title={fullTitle} description={description ?? tr('site.description')} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr('a11y.skip')}</a>
    <Header lang={lang} routeId={routeId} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} routeId={routeId} />
  </body>
</html>
