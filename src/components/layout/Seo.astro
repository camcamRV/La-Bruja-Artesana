---
import type { Lang } from '../../i18n/ui';
import type { RouteId } from '../../i18n/routes';
import { alternate } from '../../i18n/utils';

interface Props {
  lang: Lang;
  routeId: RouteId;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, routeId, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const alt = alternate(routeId, site);
const canonical = alt[lang];
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex" />
) : (
  <>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alt.es} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.es} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="La Bruja Artesana" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CO'} />
